# ============================================
# SaludYA — variables de entorno (PLANTILLA)
# Copia este archivo como ".env" y ajusta los valores.
# El ".env" real NUNCA se sube al repositorio (ver .gitignore).
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=saludya_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=saludya_db
POSTGRES_PORT=5432

# --- FastAPI ---
APP_NAME=SaludYA API
APP_ENV=development

# ============================================
# Variables que se agregarán en próximas partes
# (se dejan documentadas aquí, pero NO se usan todavía):
#
# JWT_SECRET=                  (Parte de JWT)
# JWT_EXPIRE_MINUTES=          (Parte de JWT)
# OTP_EXPIRE_MINUTES=5         (Parte de OTP — ya decidido: 5 minutos)
# OTP_MAX_INTENTOS=3           (Parte de OTP — ya decidido: 3 intentos)
# OTP_REENVIO_SEGUNDOS=60      (Parte de OTP — ya decidido: 60 segundos)
# WHATSAPP_ACCESS_TOKEN=       (Parte de WhatsApp)
# WHATSAPP_PHONE_NUMBER_ID=    (Parte de WhatsApp)
# WHATSAPP_VERIFY_TOKEN=       (Parte de WhatsApp)
# RESEND_API_KEY=              (cuando exista una HU que lo requiera)
# OPENAI_API_KEY=              (fuera de Sprint 1)
# ============================================
