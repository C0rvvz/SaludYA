# ============================================
# SaludYA — variables de entorno (PLANTILLA)
# Copia este archivo como ".env" y ajusta los valores.
# El ".env" real NUNCA se sube al repositorio (ver .gitignore).
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=saludya_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=saludya_db
POSTGRES_PORT=5432

# --- FastAPI ---
APP_NAME=SaludYA API
APP_ENV=development

# --- OTP (HU-02, HU-03, HU-04) ---
OTP_EXPIRE_MINUTES=5
OTP_MAX_INTENTOS=3
OTP_REENVIO_SEGUNDOS=60

# --- WhatsApp Cloud API (HU-02, HU-04) ---
# "mock" mientras no haya credenciales reales de Meta configuradas.
# Cambia a "real" cuando las tengas (y completa las 3 variables de abajo).
WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- JWT (HU-03) ---
# Genera tu propio valor con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# NUNCA reutilices el valor de ejemplo del repositorio en un ambiente real.
JWT_SECRET=cambia_este_valor_por_uno_generado_aleatoriamente
JWT_EXPIRE_MINUTES=60

# --- Asistente conversacional con IA (HU-33) ---
# Cualquier proveedor compatible con la API de OpenAI. Por defecto,
# Gemini en su plan gratuito (llave en https://aistudio.google.com/apikey).
# Para usar OpenAI: deja IA_BASE_URL vacía e IA_MODELO=gpt-4o-mini.
# Solo se usa en el backend. Sin llave, la API arranca igual pero el
# chat responde que el asistente no está disponible.
IA_API_KEY=
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
IA_MODELO=gemini-3.8-flash

# ============================================
# Variables que se agregarán en próximas partes (todavía no se usan):
#
# RESEND_API_KEY=              (cuando exista una HU que lo requiera)
# ============================================

# --- CORS (Parte 11: necesario para el frontend) ---
CORS_ORIGINS=http://localhost:5173
