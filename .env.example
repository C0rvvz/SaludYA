# ============================================
# SaludYA — variables de entorno (PLANTILLA)
# Copia este archivo como ".env" y ajusta los valores.
# El ".env" real NUNCA se sube al repositorio (ver .gitignore).
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=saludya_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=saludya_db
POSTGRES_PORT=5432

# --- FastAPI ---
APP_NAME=SaludYA API
APP_ENV=development

# --- OTP (HU-02, HU-03, HU-04) ---
OTP_EXPIRE_MINUTES=5
OTP_MAX_INTENTOS=3
OTP_REENVIO_SEGUNDOS=60

# --- WhatsApp Cloud API (HU-02, HU-04) ---
# "mock" mientras no haya credenciales reales de Meta configuradas.
# Cambia a "real" cuando las tengas (y completa las 3 variables de abajo).
WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ============================================
# Variables que se agregarán en próximas partes (todavía no se usan):
#
# JWT_SECRET=                  (Parte de JWT)
# JWT_EXPIRE_MINUTES=          (Parte de JWT)
# RESEND_API_KEY=              (cuando exista una HU que lo requiera)
# OPENAI_API_KEY=              (fuera de Sprint 1)
# ============================================
